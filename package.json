{
  "name": "babylog",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nt1r/babylog.git"
  },
  "homepage": "https://github.com/nt1r/babylog#readme",
  "bugs": {
    "url": "https://github.com/nt1r/babylog/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:server\" \"sh ./scripts/dev-web.sh\"",
    "dev:web": "vite",
    "dev:server": "BABYLOG_WORK_DIR=\"$PWD\" sh -c 'cd backend && exec go run github.com/air-verse/air@v1.67.4 -c .air.toml'",
    "dev:reset-db": "sh ./scripts/dev-reset-db.sh",
    "admin:init": "BABYLOG_WORK_DIR=\"$PWD\" sh -c 'cd backend && exec go run ./cmd/babylog admin init \"$@\"' --",
    "lint": "pnpm lint:web && pnpm lint:guardrails && pnpm lint:go",
    "lint:web": "biome check --error-on-warnings .",
    "lint:guardrails": "sh ./scripts/lint-guardrails.sh",
    "lint:go": "sh ./scripts/lint-go.sh",
    "format": "biome check --write . && (cd backend && gofmt -w .)",
    "check": "tsc --noEmit",
    "test": "sh ./scripts/test-go.sh",
    "test:verbose": "sh ./scripts/test-go.sh --verbose",
    "test:integration": "sh ./scripts/test-go.sh --integration",
    "test:race": "sh ./scripts/test-go.sh --race",
    "release": "sh ./scripts/release.sh",
    "release:check": "sh ./scripts/release-check.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "sh ./scripts/build-server.sh",
    "start": "./bin/babylog serve"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.78.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "shadcn": "4.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
