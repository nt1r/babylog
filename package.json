{
  "name": "babylog",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nt1r/babylog.git"
  },
  "homepage": "https://github.com/nt1r/babylog#readme",
  "bugs": {
    "url": "https://github.com/nt1r/babylog/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.ts",
    "admin:init": "node scripts/init-admin.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "tsc --noEmit",
    "test": "node --test server/auth.test.ts scripts/init-admin.test.ts server/index.test.ts",
    "build": "vite build",
    "start": "node server/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "shadcn": "4.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
